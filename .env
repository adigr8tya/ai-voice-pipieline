# Copy this file to ".env" and fill in real values.
# NEVER commit ".env" or paste real keys in chat.

# Step 1B: debug audio (saves each call as a .wav in DEBUG_AUDIO_DIR).
# Contains customer voice: set SAVE_DEBUG_AUDIO=0 when testing is done.
SAVE_DEBUG_AUDIO=1
DEBUG_AUDIO_DIR=debug_audio

# Step 1C: Deepgram STT. Get a key at https://console.deepgram.com
DEEPGRAM_API_KEY=cd0c5ffde3f460998016fdf6119f847fa797fda0
# Optional (these are the defaults): nova-3 multilingual = Hindi + English
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# Step 1D: Exotel (Exotel dashboard -> Settings -> API settings)
EXOTEL_ACCOUNT_SID=ac
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# api.in.exotel.com = Mumbai cluster, api.exotel.com = Singapore cluster
EXOTEL_SUBDOMAIN=api.in.exotel.com
# Your ExoPhone (the number the customer sees)
EXOTEL_CALLER_ID=a
# Public address of our /ws endpoint (from the tunnel), e.g. wss://xxxx.trycloudflare.com/ws
STREAM_URL=
